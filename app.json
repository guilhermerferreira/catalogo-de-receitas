{
  "expo": {
    "name": "reactNative",
    "slug": "reactNative",
    "scheme": "pitada",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
